diff --git a/shell/style/shell.css b/shell/style/shell.css
index 51e0d70..e911955 100644
--- a/shell/style/shell.css
+++ b/shell/style/shell.css
@@ -408,3 +408,187 @@ window.reglages { background-color: @surface-alt; }
   border-radius: 10px;
   background-color: @surface-alt;
 }
+
+/* -------------------------------------------------------------------------
+   Lanceur d'applications
+
+   Mêmes surfaces, mêmes rayons, mêmes ombres que le dock et la barre : le
+   lanceur doit avoir l'air d'appartenir au même bureau, pas d'une
+   application ouverte par-dessus.
+   ------------------------------------------------------------------------- */
+
+.lanceur-cadre {
+  background-color: @surface;
+  border: 1px solid @border;
+  border-radius: 20px;
+  padding: 16px;
+  /* Même doublement d'ombre que le dock : une large pour l'élévation, une
+     courte pour asseoir le contact. */
+  box-shadow: 0 12px 36px @shadow,
+              0 2px   8px @shadow-close;
+}
+
+/* --- barre d'outils ------------------------------------------------------ */
+
+.lanceur-barre { padding: 0 2px 2px 2px; }
+
+.lanceur-libelle {
+  font-size: 12px;
+  color: @text-dim;
+  margin-left: 6px;
+}
+
+/* « background: none » d'abord : Adwaita peint les entrées avec un
+   background-IMAGE qui recouvrirait toute couleur posée dessous. Même piège
+   que les pastilles des réglages rapides. */
+.lanceur-recherche {
+  background: none;
+  background-color: @surface-alt;
+  border: 1px solid transparent;
+  box-shadow: none;
+  border-radius: 999px;
+  padding: 6px 12px;
+  font-size: 13px;
+  color: @text;
+  min-height: 32px;
+}
+
+.lanceur-recherche:focus-within { border-color: @accent; }
+
+.lanceur-tri > button {
+  background: none;
+  background-color: @surface-alt;
+  border: 1px solid transparent;
+  box-shadow: none;
+  border-radius: 999px;
+  padding: 4px 12px;
+  font-size: 13px;
+  color: @text;
+  min-height: 32px;
+}
+
+.lanceur-tri > button:hover { background-color: @surface-sunk; }
+
+/* --- segments « Afficher » ----------------------------------------------- */
+
+/* Trois boutons soudés : rayons aux extrémités seulement, pour qu'ils
+   forment un objet et non trois. */
+.lanceur-vues button {
+  background: none;
+  background-color: @surface-alt;
+  border: none;
+  box-shadow: none;
+  border-radius: 0;
+  padding: 5px 12px;
+  font-size: 12px;
+  color: @text;
+  min-height: 32px;
+  transition: background-color 120ms ease-out;
+}
+
+.lanceur-vues button:first-child {
+  border-radius: 999px 0 0 999px;
+  padding-left: 14px;
+}
+
+.lanceur-vues button:last-child {
+  border-radius: 0 999px 999px 0;
+  padding-right: 14px;
+}
+
+.lanceur-vues button:hover   { background-color: @surface-sunk; }
+
+/* La vue active prend l'accent : c'est le seul endroit coloré de la barre,
+   et il faut le lire d'un coup d'œil. */
+.lanceur-vues button:checked {
+  background-color: @accent;
+  color: @on-accent;
+}
+
+.lanceur-vues button:checked:hover { background-color: @accent-hover; }
+
+/* --- contenu ------------------------------------------------------------- */
+
+.lanceur-contenu {
+  background-color: transparent;
+  padding: 4px 0;
+}
+
+/* La ligne de séparation par défaut de GtkListBox couperait la liste en
+   tranches ; les espacements suffisent à la lire. */
+.lanceur-contenu > row {
+  background-color: transparent;
+  padding: 0;
+}
+
+.lanceur-item {
+  background: none;
+  background-color: transparent;
+  border: none;
+  box-shadow: none;
+  border-radius: 12px;
+  color: @text;
+  transition: background-color 120ms ease-out;
+}
+
+.lanceur-item.grille {
+  padding: 12px 6px;
+  min-width: 118px;
+}
+
+.lanceur-item.liste   { padding: 7px 10px; }
+.lanceur-item.details { padding: 9px 10px; }
+
+.lanceur-item:hover { background-color: @surface-sunk; }
+
+/* Déjà épinglée au dock. Même vocabulaire que le point sous une icône du
+   dock : la surface se détache très légèrement, sans crier. */
+.lanceur-item.epinglee { background-color: @surface-alt; }
+
+.lanceur-nom       { font-size: 13px; color: @text; }
+.lanceur-detail    { font-size: 11px; color: @text-dim; }
+.lanceur-categorie { font-size: 11px; color: @text-dim; }
+
+.lanceur-vide { font-size: 14px; color: @text-dim; }
+
+/* -------------------------------------------------------------------------
+   Menus contextuels — dock et lanceur
+
+   GTK dessine le fond d'un popover sur son nœud « contents » : c'est là que
+   vont le rayon et l'ombre, pas sur le popover lui-même.
+   ------------------------------------------------------------------------- */
+
+popover.dock-menu > contents,
+popover.lanceur-menu > contents {
+  background-color: @surface;
+  border: 1px solid @border;
+  border-radius: 14px;
+  padding: 6px;
+  box-shadow: 0 12px 36px @shadow,
+              0 2px   8px @shadow-close;
+}
+
+popover.dock-menu modelbutton,
+popover.lanceur-menu modelbutton {
+  border-radius: 9px;
+  padding: 7px 12px;
+  font-size: 13px;
+  color: @text;
+  min-height: 0;
+}
+
+popover.dock-menu modelbutton:hover,
+popover.lanceur-menu modelbutton:hover { background-color: @surface-alt; }
+
+/* -------------------------------------------------------------------------
+   Bouton du lanceur, à gauche du dock
+   ------------------------------------------------------------------------- */
+
+/* Rond plutôt que carré arrondi : il ouvre une liste, il ne représente pas
+   une application. La forme dit la différence avant qu'on lise l'icône. */
+.dock-lanceur {
+  border-radius: 999px;
+  color: @text-dim;
+}
+
+.dock-lanceur:hover { color: @text; }
