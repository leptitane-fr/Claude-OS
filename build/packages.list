# Claude-OS -- paquets installes dans le systeme cible.
# Une ligne par paquet ; # commence un commentaire.
#
# Le systeme est volontairement reduit : Chromium et Claude Desktop, plus
# ce qu'il faut pour les faire tourner. Chaque paquet en plus, c'est de
# l'espace, des ecritures, des mises a jour et de la surface d'attaque.

# --- Noyau et amorcage ------------------------------------------------------
# linux-image-amd64 n'est PAS ici : build.sh l'installe separement, depuis
# trixie-backports ou depuis stable selon ENABLE_BACKPORTS_KERNEL. L'inclure
# ici installerait les deux noyaux, soit 400 Mo pour rien.
initramfs-tools
grub-efi-amd64                # GRUB non signe : fournit grub-install
grub-efi-amd64-signed         # image GRUB signee par Debian
shim-signed                   # maillon signe par Microsoft : la cle de voute
efibootmgr                    # inspection uniquement -- jamais d'ecriture NVRAM

# --- Firmwares (composant non-free-firmware) --------------------------------
intel-microcode               # correctifs CPU ; aussi des gains d'energie
firmware-linux-free
# Trixie a scinde linux-firmware par constructeur. On ne prend que l'Intel :
# le paquet fourre-tout firmware-misc-nonfree pese plusieurs centaines de Mo
# de firmwares AMD, Qualcomm et autres, sans aucune utilite ici.
firmware-intel-graphics       # GuC/HuC : decodage video efficace sur l'iGPU
firmware-intel-misc
firmware-intel-sound
firmware-iwlwifi              # Wi-Fi Intel AX
firmware-sof-signed           # audio Alder Lake : muet sans ce paquet
# Les Vivobook embarquent selon les series une carte Intel, MediaTek ou
# Realtek. Ne garder que l'Intel etait une economie mal placee : une carte
# non reconnue rend le systeme inutilisable, alors que ces paquets pesent
# quelques dizaines de Mo -- et qui se compressent tres bien.
firmware-mediatek
firmware-realtek
firmware-atheros

# --- Base systeme -----------------------------------------------------------
systemd
systemd-timesyncd
# e2fsprogs n'est PAS inclus par debootstrap --variant=minbase, et rien
# ci-dessous ne l'entraine sans les recommandes. Sans lui : pas de fsck.ext4
# au demarrage, et surtout pas de resize2fs -- le premier demarrage
# agrandirait la partition sans pouvoir etendre le systeme de fichiers,
# laissant 240 Go inutilisables sur la cle.
e2fsprogs
dosfstools                    # fsck.vfat pour la partition EFI
systemd-zram-generator        # swap compresse en RAM, aucune ecriture flash
dbus
sudo
locales
console-setup
keyboard-configuration
ca-certificates
apt-utils

# --- Reseau -----------------------------------------------------------------
network-manager
network-manager-gnome         # applet de barre des taches
iproute2
iputils-ping
wpasupplicant

# --- Graphique : Intel uniquement -------------------------------------------
# Aucun paquet NVIDIA nulle part, par construction. Un pilote DKMS casserait
# de toute facon Secure Boot faute de signature.
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-intel      # au profit de modesetting si besoin
libgl1-mesa-dri
mesa-va-drivers
intel-media-va-driver-non-free  # iHD : decodage video materiel Alder Lake
vainfo                        # verification de l'acceleration
mesa-utils

# --- Bureau Xfce ------------------------------------------------------------
# Composants choisis un par un plutot que le metapaquet xfce4, qui tire
# beaucoup d'applications inutiles ici.
xfce4-session
xfwm4
xfdesktop4
xfce4-panel
xfce4-settings
xfce4-terminal
xfce4-power-manager
xfce4-notifyd
xfce4-screenshooter
xfce4-whiskermenu-plugin
thunar
thunar-volman
gvfs
gvfs-backends
lightdm
lightdm-gtk-greeter
xdg-utils
xdg-desktop-portal
xdg-desktop-portal-gtk        # dialogues de fichiers pour Chromium/Electron
# Agent d'authentification polkit. Sans lui, NetworkManager refuse toute
# operation a l'utilisateur avec « permission refusee » -- y compris se
# connecter a un reseau, ce qui rend le systeme difficilement utilisable.
polkitd
mate-polkit                   # agent GTK, fonctionne sous Xfce
                              # (xfce-polkit n'existe pas dans Trixie)

# --- Trousseau : indispensable a Claude Desktop et Chromium -----------------
# Electron stocke le jeton de session via libsecret. Sans fournisseur Secret
# Service, il faut se reconnecter a chaque demarrage.
gnome-keyring
libsecret-1-0
seahorse

# --- Bluetooth ---------------------------------------------------------------
# Pas un accessoire ici : la carte Wi-Fi MT7902 de ce Vivobook n'est pas
# initialisable sous Linux, alors que la moitie Bluetooth de la MEME puce
# fonctionne (elle passe par l'USB, pas par le PCIe). Le partage de connexion
# Bluetooth depuis un telephone devient donc la solution de mobilite : pas de
# dongle qui depasse, pas de port occupe.
#
# Le firmware est deja fourni par firmware-mediatek ; seule la couche
# logicielle manquait.
bluez
blueman                       # applet GTK : appairage et partage en deux clics

# --- Audio ------------------------------------------------------------------
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pavucontrol

# --- Energie ----------------------------------------------------------------
tlp
tlp-rdw
thermald                      # regulation thermique Intel
powertop
acpi
lm-sensors

# --- Shell graphique Claude-OS ----------------------------------------------
# Compositeur Wayland et bibliotheques du shell sur-mesure. labwc pese ~15 Mo
# en memoire, contre ~120 Mo pour la session Xfce complete.
labwc
gtk4-layer-shell              # ancrage du dock hors du flux des fenetres

# Filet pour les applications qui ne savent pas parler Wayland. Chromium et
# Claude Desktop savent le faire nativement, mais un utilitaire ponctuel qui
# ne demarrerait pas du tout serait un piege. Xwayland ne tourne que si une
# application X11 le reclame : au repos il ne coute rien.
xwayland

# gapplication : le raccourci clavier de labwc appelle par lui l'action
# « basculer » que le dock et la barre publient sur le bus de session. Sans
# ce paquet, la touche de masquage ne ferait rien.
libglib2.0-bin

# Papirus plutot qu'Adwaita : verifie a l'ecran, Adwaita a abandonne les noms
# d'icones herites (web-browser, utilities-terminal...) que la plupart des
# .desktop declarent encore, et affiche un pictogramme generique a leur place.
# Papirus les conserve, et son style plat et arrondi est proche de ChromeOS.
papirus-icon-theme

# --- Polices : le systeme sert a afficher du web ---------------------------
fonts-inter                   # police de l'interface, proche de la Google Sans
fonts-dejavu
fonts-liberation2             # substituts metriques Arial/Times/Courier
fonts-noto-core
fonts-noto-color-emoji

# --- Applications -----------------------------------------------------------
chromium
chromium-l10n

# --- Outils de diagnostic ---------------------------------------------------
pciutils
usbutils
lsof
htop
nano
less
curl
gnupg
git
rsync
gdisk                         # sgdisk : extension de la racine au 1er demarrage
acpica-tools                  # acpidump/iasl : analyse du dGPU sur site
