# Claude OS — la porte du coffre.
#
# C'EST CE FICHIER QUI PROTÈGE LE COFFRE, et rien d'autre.
#
# claude-os-coffre tourne en root et rend un mot de passe contre un code
# PIN. Il n'est ni setuid, ni déclaré dans sudoers, et aucun compte ordinaire
# n'a de chemin pour l'exécuter : la socket ci-dessous est la seule entrée,
# et elle n'est ouverte qu'à « _greetd », le compte de l'écran de connexion.
#
# Le programme REDIT cette règle de son côté, par SO_PEERCRED. Les deux
# verrous sont volontairement redondants : ce fichier peut être remplacé par
# une mise à jour ou une erreur de déploiement, la vérification compilée,
# non.
#
# MaxConnections=4 N'EST PAS UNE VALEUR DÉCORATIVE. Chaque connexion lance une
# instance qui alloue 128 Mio pour Argon2id. Avec la valeur par défaut — 64 —
# un « _greetd » compromis ferait réserver 8 Go sur une machine qui en a 4,
# et la mettrait à genoux avant même l'ouverture de session. Le greeter ne
# pose jamais qu'une question à la fois ; quatre est déjà large.

[Unit]
Description=Coffre des codes PIN de Claude OS (socket)
Documentation=file:/home/stef/Claude-OS/docs/09-code-pin.md

[Socket]
ListenStream=/run/claude-os/coffre.sock
SocketUser=_greetd
# GROUPE « users », ET NON « _greetd ».
#
# Le verrou d'écran tourne sous le compte de l'utilisateur et doit joindre
# le coffre pour déverrouiller au code PIN. « users » est choisi parce que
# le compte y appartient DÉJÀ : créer un groupe dédié aurait obligé à
# rouvrir la session pour que l'appartenance prenne effet — le piège que
# console.c documente à propos du groupe « video ».
#
# Ce n'est pas la socket qui décide : coffre.c revérifie l'appelant par
# SO_PEERCRED, et un compte ordinaire n'obtient que son propre coffre, en
# lecture et ouverture seulement.
SocketGroup=users
SocketMode=0660
Accept=yes
MaxConnections=4

[Install]
WantedBy=sockets.target
