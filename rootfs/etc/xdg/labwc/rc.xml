<?xml version="1.0"?>
<!--
  Claude-OS — configuration de labwc

  Volontairement minimale : ce compositeur ne sert qu'à porter le shell
  sur-mesure. Tout ce qui relève de l'apparence est dans le shell, pas ici.
-->
<labwc_config>

  <core>
    <!-- SERVEUR, ET C'EST LE DÉFAUT DE labwc.
         Le projet avait choisi « client » en pensant que le dock et la barre
         suffisaient. Mais « client » demande à chaque application de dessiner
         sa propre barre de titre — et celles qui implémentent le protocole de
         décoration, Chromium et Claude Desktop en tête, n'en dessinent alors
         aucune : plus de bouton réduire ni agrandir, plus rien à saisir pour
         déplacer la fenêtre.
         En « serveur », labwc pose une barre de titre à toute fenêtre qui n'en
         fournit pas. Les applications GTK gardent la leur, elles ne sont pas
         concernées ; vérifié au banc d'essai sur les fenêtres du projet. -->
    <decoration>server</decoration>
    <gap>0</gap>
  </core>

  <theme>
    <!-- NOTRE THÈME, ET PAS SEULEMENT DES COULEURS.
         Les images de boutons ne se surchargent pas : labwc les cherche dans
         le répertoire du thème. Sans <name>, on héritait des masques XBM par
         défaut — fins, monochromes et crénelés. Le thème est déployé par
         rootfs/ dans /usr/share/themes/Claude-OS/labwc/.
         Le themerc-override de ~/.config/labwc continue de primer : c'est lui
         que claude-os-theme réécrit à chaque bascule clair/sombre. -->
    <name>Claude-OS</name>
    <!-- Pas d'ombre portée du compositeur : les surfaces du shell portent
         déjà la leur, en CSS, calculée une seule fois. -->
    <dropShadows>no</dropShadows>
  </theme>

  <keyboard>
    <!-- Raccourcis intégrés de labwc (Alt-Tab, Alt-F4, déplacements...).
         Sans cette ligne, définir le moindre raccourci ci-dessous les
         supprimerait tous : labwc ne charge ses valeurs par défaut que si on
         le lui demande explicitement (src/config/rcxml.c, « default.keyboard »). -->
    <default />

    <!-- Faire paraître / renvoyer le dock et la barre d'état.

         Sur le Chromebook, c'est la touche Loupe (recherche) : le noyau
         l'émet comme KEY_LEFTMETA, que XKB nomme Super_L.

         Depuis le 11 septembre 2026, le dock et la barre sortent d'eux-mêmes
         de l'écran dès qu'une application passe au premier plan ; cette
         touche les rappelle (un court glisser du doigt depuis le bord bas
         aussi). Le script ne s'adresse qu'au dock, qui décide et entraîne la
         barre : voir shell/src/visibility.h.

         Deux liaisons pour la même action, et ce n'est pas de l'excès de
         zèle. Mesuré ici : labwc déclenche bien « Super_L » quand la touche
         arrive comme touche ordinaire, mais pas quand elle arrive comme
         modificateur seul. Le comportement du clavier réel n'a pas pu être
         reproduit sans matériel, donc Super+Espace est fourni comme
         solution de repli garantie.

         Si la touche Windows seule se déclenche en trop pendant d'autres
         raccourcis Super, supprimer la première liaison suffit. -->
    <keybind key="Super_L">
      <action name="Execute" command="/usr/local/bin/claude-os-shell-basculer"/>
    </keybind>
    <keybind key="W-space">
      <action name="Execute" command="/usr/local/bin/claude-os-shell-basculer"/>
    </keybind>

    <!-- Le lanceur d'applications. Super seul bascule déjà le dock et la
         barre d'état : on ne le lui reprend pas. Super+A, comme
         « applications ». -->
    <keybind key="W-a">
      <action name="Execute" command="claude-os-lanceur"/>
    </keybind>

    <!-- Filets de sécurité : les seuls moyens d'ouvrir quoi que ce soit si
         le dock ET le lanceur refusent de démarrer. Un terminal et un
         navigateur, joignables au clavier quoi qu'il arrive. -->
    <keybind key="W-Return">
      <action name="Execute" command="foot"/>
    </keybind>
    <keybind key="W-b">
      <action name="Execute" command="chromium"/>
    </keybind>

    <keybind key="W-f">
      <action name="ToggleFullscreen"/>
    </keybind>

    <!-- Quitter la session. Volontairement peu accessible au doigt, mais il
         doit exister : une session sans sortie au clavier est un piège. -->
    <keybind key="W-S-q">
      <action name="Exit"/>
    </keybind>

    <!-- Rangée du haut du clavier Chromebook (Google Madoo).

         Le noyau expose cette rangée en mode « vivaldi » ; sa disposition se
         lit dans /sys/devices/platform/i8042/serio0/function_row_physmap :

             EA  précédent    KEY_BACK
             E9  suivant      KEY_FORWARD
             E7  recharger    KEY_REFRESH
             91  plein écran  KEY_FULL_SCREEN     372
             92  aperçu       KEY_SCALE           120
             94  lumière bas  KEY_BRIGHTNESSDOWN  224
             95  lumière haut KEY_BRIGHTNESSUP    225
             A0  muet         KEY_MUTE            113
             AE  volume bas   KEY_VOLUMEDOWN      114
             B0  volume haut  KEY_VOLUMEUP        115

         VOLUME. Les touches émettent bien leurs codes, vérifié dans le
         masque « B: KEY= » de /proc/bus/input/devices. Le défaut de labwc
         les liait déjà, mais à « amixer sset Master », qui échoue ici :

             $ amixer sset Master 5%+
             amixer: Unable to find simple control 'Master',0

         Cette carte (sof-rt5682) n'expose aucun contrôle « Master », et le
         son passe de toute façon par PipeWire, qu'ALSA ne pilote pas. On
         redirige donc vers wpctl. Ces liaisons viennent après <default /> :
         labwc remplace les doublons plutôt que de les cumuler, il l'écrit
         au chargement sous la forme « Replaced N keybinds ».

         Le « -l 1.0 » plafonne à 100 %. Sans lui wpctl monte au delà et
         sature l'amplification logicielle. -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+ -l 1.0"/>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"/>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"/>
    </keybind>

    <!-- PLEIN ÉCRAN. Cause différente : cette touche n'était liée à rien.
         Elle émet KEY_FULL_SCREEN (372), que XKB nomme <I380> et traduit en
         keysym XF86FullScreen, défini dans symbols/inet et inclus dans
         toutes les dispositions par « * = +inet(evdev) » (rules/evdev).

         W-f, défini plus haut, reste valable en parallèle. -->
    <keybind key="XF86FullScreen">
      <action name="ToggleFullscreen"/>
    </keybind>
  </keyboard>

  <!-- LE DOIGT ET LE STYLET SUIVENT L'ÉCRAN QUAND IL TOURNE.
       En mode tablette, le dock tourne l'image (shell/src/rotation.c, par
       wlr-randr). Sans association à une sortie, wlroots rapporte l'écran
       tactile à la disposition entière et NON tournée : le doigt toucherait
       l'endroit où le point serait si l'écran n'avait pas tourné. Associé
       à eDP-1, il applique la transformation de la sortie ; labwc(5) le dit
       pour le stylet, wlroots le fait pour le toucher.

       Le nom du périphérique est celui de /proc/bus/input/devices : écran
       Goodix, relevé le 11 septembre 2026 sur MADOO. Le stylet, lui, est
       une « tablette » pour libinput (ID_INPUT_TABLET) : il a sa section.

       Aucun effet capot ouvert : la sortie est alors la disposition
       entière, l'association ne change rien. -->
  <touch deviceName="GDIX0000:00 27C6:0E88" mapToOutput="eDP-1" mouseEmulation="no"/>
  <tablet mapToOutput="eDP-1" rotate="0" mouseEmulation="no"/>

</labwc_config>
