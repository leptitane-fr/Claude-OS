# Environnement de la session labwc.
#
# labwc lit ce fichier AVANT de créer le clavier XKB et avant de lancer
# l'autostart : c'est le seul endroit où poser ce qui doit valoir pour toute
# la session.

# Disposition du clavier : azerty.
XKB_DEFAULT_LAYOUT=fr

# GTK parle Wayland directement. Sans cela il peut retomber sur X11 via
# Xwayland, ce qui ajoute un serveur entier en mémoire pour rien.
GDK_BACKEND=wayland

# Une session ouverte par greetd ne passe pas par un fichier .desktop lu par
# un gestionnaire X11. Ces trois marqueurs doivent donc etre presents dans
# l'environnement du compositeur lui-meme, sinon certains clients Electron et
# certains portails concluent a tort qu'ils doivent chercher Xwayland.
XDG_SESSION_TYPE=wayland
XDG_CURRENT_DESKTOP=labwc
XDG_SESSION_DESKTOP=claude-os

# Qt, au cas où une application en amènerait une bibliothèque.
QT_QPA_PLATFORM=wayland

# Electron/Chromium : preference Wayland meme avant que le lanceur dedie ne
# soit pris en compte.
ELECTRON_OZONE_PLATFORM_HINT=wayland
MOZ_ENABLE_WAYLAND=1

# Accessibilité : aucun bus a11y sur cette machine.
#
# at-spi2 n'est pas installé, et « org.a11y.Bus » n'est fourni par aucun
# fichier .service. Chaque composant GTK4 tente malgré tout de le joindre au
# démarrage, échoue, et verse cinq lignes d'avertissement dans shell.log —
# quatre fois par ouverture de session, mesuré le 8 septembre 2026.
#
# Le coût en temps est marginal ; ce qui compte est le bruit. L'invariant n°4
# dit qu'aucune sortie n'est jetée : un journal utile est un journal où une
# vraie erreur se voit. Ces avertissements-là noient tout le reste.
#
# GTK documente cette valeur exactement pour ce cas — le message d'erreur la
# nomme lui-même : « If you are attempting to run GTK without a11y support,
# GTK_A11Y should be set to 'none' ».
#
# À REVOIR le jour où l'accessibilité est mise au programme : cette ligne la
# désactive pour toute la session, y compris pour les applications tierces.
GTK_A11Y=none
