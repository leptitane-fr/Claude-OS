# Claude OS — thème de fenêtre
#
# Objectif : barre de titre seule. Aucun cadre à gauche, à droite ni en bas.
# C'est « border.width: 0 » qui supprime le contour, et « window.handle.width: 0 »
# la poignée de redimensionnement du bas — les deux sont nécessaires, l'une sans
# l'autre laisse un liseré.

#--- Géométrie : tout ce qui n'est pas la barre de titre est ramené à zéro
border.width: 0
padding.width: 8
padding.height: 7
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap.x: 0
menu.overlap.y: 0

#--- Barre de titre
window.active.title.bg: flat solid
window.active.title.bg.color: #202124
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1a1b1e

window.active.label.bg: parentrelative
window.inactive.label.bg: parentrelative
window.active.label.text.color: #e8eaed
window.inactive.label.text.color: #9aa0a6
window.label.text.justify: center

window.active.button.unpressed.image.color: #e8eaed
window.inactive.button.unpressed.image.color: #9aa0a6
window.active.button.hover.image.color: #ffffff
window.inactive.button.hover.image.color: #e8eaed
window.active.button.pressed.image.color: #8ab4f8
window.active.button.disabled.image.color: #5f6368
window.inactive.button.disabled.image.color: #45484d

# Pastille bleue au survol des boutons, dans les codes du dock
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #33415a
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #2a2d33
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #3c4d6b

window.button.hover.bg.corner-radius: 6
window.active.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.bg: parentrelative

#--- Bordures internes : neutralisées
window.active.border.color: #202124
window.inactive.border.color: #1a1b1e
window.active.client.color: #202124
window.inactive.client.color: #1a1b1e

#--- Menu (clic droit sur le bureau)
menu.border.width: 1
menu.border.color: #3c4043
menu.title.bg: flat solid
menu.title.bg.color: #202124
menu.title.text.color: #e8eaed
menu.title.text.justify: center
menu.items.bg: flat solid
menu.items.bg.color: #202124
menu.items.text.color: #e8eaed
menu.items.disabled.text.color: #5f6368
menu.items.active.bg: flat solid
menu.items.active.bg.color: #33415a
menu.items.active.text.color: #ffffff
menu.separator.color: #3c4043
menu.separator.width: 1
menu.separator.padding.width: 6
menu.separator.padding.height: 3

#--- Info-bulles de déplacement / redimensionnement
osd.border.width: 1
osd.border.color: #3c4043
osd.bg: flat solid
osd.bg.color: #202124
osd.label.bg: parentrelative
osd.label.text.color: #e8eaed
osd.hilight.bg: flat solid
osd.hilight.bg.color: #8ab4f8
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #3c4043
