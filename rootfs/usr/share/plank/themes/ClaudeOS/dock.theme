# Claude OS — thème du dock
#
# Mêmes codes visuels que la barre d'état tint2, pour que les deux se lisent
# comme un seul ensemble : fond #202124 à 90 %, filet blanc à 10 %, rayon 18.
# Les couleurs s'écrivent R;;V;;B;;A, l'alpha de 0 à 255 (230 ≈ 90 %).

[PlankTheme]
TopRoundness=18
BottomRoundness=18
LineWidth=1
OuterStrokeColor=255;;255;;255;;26
FillStartColor=32;;33;;36;;230
FillEndColor=32;;33;;36;;230
InnerStrokeColor=255;;255;;255;;0

[PlankDockTheme]
HorizPadding=8
TopPadding=4
BottomPadding=4
ItemPadding=4
IndicatorSize=5
# Ombre portée sous chaque icône : c'est ce réglage qui donne l'ombrage des
# icônes demandé. tint2 ne savait pas le faire.
IconShadowSize=2
UrgentBounceHeight=1.6666666666666667
LaunchBounceHeight=0.625
FadeOpacity=1.0
ClickTime=300
UrgentBounceTime=600
LaunchBounceTime=600
ActiveTime=300
SlideTime=300
FadeTime=250
HideTime=250
GlowSize=30
GlowTime=10000
GlowPulseTime=2000
UrgentHueShift=150
ItemMoveTime=450
CascadeHide=true
