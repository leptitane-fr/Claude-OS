# Claude OS — réglages du dock plank
#
# Déposé dans ~/.config/plank/dock1/settings au provisionnement, puis modifiable
# à la souris : plank enregistre lui-même les changements, y compris l'ordre des
# icônes réorganisées par glisser-déposer.
#
# Position : 3 = bas.  Alignment : 3 = centré.
# HideMode : 0 = jamais masqué. Le dock ne réserve pas d'espace, donc les
# fenêtres maximisées passent dessous.

[PlankDockPreferences]
CurrentWorkspaceOnly=false
IconSize=40
HideMode=0
UnhideDelay=0
HideDelay=0
Monitor=
DockItems=claude-os-launcher.dockitem;;claude-os-chromium.dockitem;;claude-os-claude.dockitem;;claude-os-notes.dockitem
Position=3
Offset=0
Theme=ClaudeOS
Alignment=3
ItemsAlignment=3
LockItems=false
PressureReveal=false
PinnedOnly=false
AutoPinning=true
ShowDockItem=false
ZoomEnabled=true
ZoomPercent=120
