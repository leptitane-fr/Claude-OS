#!/bin/sh
#-------------------------------------------------------------------------------
# Claude OS — Lancement de Claude Desktop
#
# POURQUOI CE LANCEUR
# Claude Desktop est une application Electron qui tente X11 par défaut. Sous le
# shell Wayland, elle échoue sur « Missing X server or $DISPLAY ».
#
# La variable ELECTRON_OZONE_PLATFORM_HINT ne suffit pas : mesuré sur la
# machine, l'application l'ignore et cherche quand même un serveur X. Seul le
# drapeau en ligne de commande fonctionne.
#
# Le drapeau n'est PAS codé en dur : il n'est ajouté que si une session Wayland
# est effectivement là. Le même lanceur reste donc valable sous la session X11,
# où le forcer empêcherait au contraire l'application de démarrer.
#
# LE TROUSSEAU
# Chromium choisit son magasin de secrets d'après XDG_CURRENT_DESKTOP. Ici
# c'est « labwc », qu'il ne reconnaît pas : il retombe sur « basic_text », le
# stockage en clair. Electron en conclut que le chiffrement est indisponible,
# et l'application refuse d'écrire son jeton de session — le journal le dit à
# chaque démarrage, « isEncryptionAvailable=false ... backend=basic_text ».
#
# Le trousseau est pourtant là : gnome-keyring tourne avec son composant
# secrets, org.freedesktop.secrets est sur le bus de session, et
# pam_gnome_keyring le déverrouille à l'ouverture de session par greetd.
# Personne ne le lui avait désigné. Mesuré le 10 septembre 2026 : avec ce
# drapeau, l'avertissement disparaît du journal.
#
# Un appelant qui désigne déjà un magasin garde le sien — claude-os-clone le
# fait pour ses profils.
#-------------------------------------------------------------------------------
set -u

BIN=/usr/bin/claude-desktop
[ -x "$BIN" ] || BIN="$(command -v claude-desktop 2>/dev/null)"
[ -n "${BIN:-}" ] && [ -x "$BIN" ] || {
	echo "claude-desktop est introuvable." >&2
	exit 127
}

TROUSSEAU=--password-store=gnome-libsecret
case " $* " in
	*" --password-store="*) TROUSSEAU='' ;;
esac

if [ -n "${WAYLAND_DISPLAY:-}" ]; then
	exec "$BIN" ${TROUSSEAU:+"$TROUSSEAU"} --ozone-platform=wayland "$@"
fi
exec "$BIN" ${TROUSSEAU:+"$TROUSSEAU"} "$@"
