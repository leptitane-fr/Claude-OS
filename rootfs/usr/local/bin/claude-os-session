#!/bin/sh
#-------------------------------------------------------------------------------
# Claude OS — Session graphique
#
# Ordre voulu : bureau, puis compositeur, puis panneaux, puis applets. Openbox
# passe en dernier avec « exec » : c'est lui qui tient la session.
#
# Tout fichier de configuration peut être surchargé en déposant son homologue
# dans ~/.config/claude-os/ — c'est ce que fait le panneau de réglages
# (claude-os-settings), qui n'écrit jamais dans /usr.
#-------------------------------------------------------------------------------
set -u

CONF=/usr/share/claude-os
USERCONF="${XDG_CONFIG_HOME:-$HOME/.config}/claude-os"
pick() { [ -f "$USERCONF/$1" ] && echo "$USERCONF/$1" || echo "$CONF/$1"; }
have() { command -v "$1" >/dev/null 2>&1; }

# Réglages X : pas d'économiseur ni de mise en veille par X — c'est logind qui
# gère la veille.
xset s off -dpms 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true

# Bureau : fond d'écran ET icônes déposées par l'utilisateur. C'est PCManFM qui
# dessine le bureau ; sans lui, Openbox n'affiche aucune icône.
#
# Le fond d'écran est fixé par le fichier de configuration de PCManFM, jamais
# par « --set-wallpaper » : cette option exige que le gestionnaire de bureau
# tourne DÉJÀ, sans quoi elle ouvre une boîte modale « Le gestionnaire de
# bureau est inactif » qui bloque le démarrage de la session.
WP="$(pick wallpaper/default.png)"
if have pcmanfm; then
	pcmanfm --desktop &
elif have xwallpaper; then
	xwallpaper --zoom "$WP" 2>/dev/null || true
fi

# Compositeur — coins arrondis et ombres. Pas de flou : voir docs/04.
have picom && picom --config "$(pick picom/picom.conf)" -b 2>/dev/null || true

# Notifications
have dunst && dunst &

# Dock : plank. Choisi pour le glisser-déposer des icônes, que tint2 ne sait
# pas faire.
#
# Sa configuration passe par GSettings, pas par un fichier : le fichier
# ~/.config/plank/dock1/settings est obsolète depuis la version 0.11 et
# totalement ignoré. D'où ce script, appliqué avant le lancement — et une seule
# fois, pour ne pas écraser l'ordre des icônes que l'utilisateur aura choisi au
# glisser-déposer.
have claude-os-plank-setup && claude-os-plank-setup
have plank && plank &

# Barre d'état, ancrée à droite
have tint2 && tint2 -c "$(pick tint2/status.tint2rc)" &

# Touche Loupe du Chromebook : xcape convertit un appui bref sur Super SEUL en
# F13, qu'Openbox lie à claude-os-toggle-shelf. Super combiné à une autre
# touche conserve son rôle.
have xcape && xcape -e 'Super_L=F13' 2>/dev/null &

# Applets de la zone de notification. Temporisés : la zone doit exister avant
# qu'ils tentent de s'y insérer, sinon leurs icônes n'apparaissent pas.
( sleep 2
  # SANS « --indicator » : cette option bascule nm-applet sur AppIndicator
  # (StatusNotifier), protocole que tint2 ne sait pas héberger — il ne gère que
  # XEmbed. Avec elle, l'icône se réduit à une fenêtre de 1x1 pixel hors du
  # panneau, ce que montrent les journaux (« add_icon ... width 1, height 1 »
  # et « systray: error code 9 »).
  have nm-applet      && nm-applet &
  have blueman-applet && blueman-applet &
) &

# Portail XDG : requis par Electron (Claude Desktop) pour les sélecteurs de
# fichiers et l'ouverture de liens
[ -x /usr/libexec/xdg-desktop-portal ] && /usr/libexec/xdg-desktop-portal &

exec openbox --config-file "$(pick openbox/rc.xml)"
