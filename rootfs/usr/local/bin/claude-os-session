#!/bin/sh
# Claude OS — lancement de la session graphique.
#
# POURQUOI CE SCRIPT PLUTÔT QUE « Exec=labwc »
#
# Les composants du shell sont des GtkApplication. Sans bus de session,
# g_application_register échoue et chacun quitte AUSSITÔT — sans fenêtre,
# sans message à l'écran. On obtient un écran noir avec le curseur, et rien
# n'indique pourquoi.
#
# Le paquet dbus-user-session fournit ce bus, et il est désormais demandé
# explicitement. Mais dépendre d'un paquet pour que la session s'affiche du
# tout est une dépendance trop fragile pour ce qu'elle porte : si le bus
# manque, on le fabrique ici.
set -u

# ---------------------------------------------------------------- le journal
#
# CE QUE LA SESSION DIT EN MOURANT DOIT SURVIVRE À SA MORT.
#
# Lancée par greetd, cette session écrit sur le terminal virtuel. Quand elle
# échoue, wlroots y déverse ses erreurs en rouge — puis greetd reprend la main
# et réaffiche l'écran de connexion par-dessus, en une seconde. Le message
# passe à l'écran, illisible, et n'atteint NI le journal systemd (la sortie ne
# va pas à greetd) NI aucun fichier. On voit « des lignes rouges qui
# défilent » et l'on n'en sait pas plus.
#
# Tout est donc consigné ici, sous le compte de l'utilisateur, qui y a
# toujours droit d'écriture. La tentative précédente est conservée en « .1 » :
# quand on regarde après coup, la panne qui intéresse est souvent l'avant-
# dernière.
ETAT="${XDG_STATE_HOME:-${HOME:-/tmp}/.local/state}/claude-os"
mkdir -p "$ETAT" 2>/dev/null || ETAT="/tmp"
JOURNAL="$ETAT/session.log"
[ -f "$JOURNAL" ] && mv -f "$JOURNAL" "$JOURNAL.1" 2>/dev/null

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR

# Cette entree est aussi utilisable depuis un ancien gestionnaire de session.
# On impose donc Wayland ici, plutot que de dependre uniquement du fichier
# environment de labwc. DISPLAY est volontairement retire : le bureau Claude
# OS ne doit jamais heriter d'un serveur X de la session precedente.
unset DISPLAY
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=labwc
export XDG_SESSION_DESKTOP=claude-os
export GDK_BACKEND=wayland
export QT_QPA_PLATFORM=wayland
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export MOZ_ENABLE_WAYLAND=1

{
	echo "=== $(date '+%Y-%m-%d %H:%M:%S') — ouverture de la session Claude OS ==="
	echo "compte           : $(id -un) (uid $(id -u))"
	echo "HOME             : ${HOME:-<vide>}"
	echo "XDG_RUNTIME_DIR  : $XDG_RUNTIME_DIR"
	echo "  existe         : $([ -d "$XDG_RUNTIME_DIR" ] && echo oui || echo 'NON <<<<')"
	echo "  bus de session : $([ -S "$XDG_RUNTIME_DIR/bus" ] && echo présent || echo absent)"
	echo "DBUS_SESSION_BUS_ADDRESS : ${DBUS_SESSION_BUS_ADDRESS:-<vide>}"
	echo "labwc            : $(command -v labwc || echo 'INTROUVABLE <<<<')"
	echo "siège            : ${XDG_SEAT:-<vide>}   VT : ${XDG_VTNR:-<vide>}"
	echo "config lue       : ${XDG_CONFIG_HOME:-$HOME/.config}/labwc puis /etc/xdg/labwc"
	# La résolution de labwc se fait FICHIER PAR FICHIER : un
	# themerc-override chez l'utilisateur ne masque pas le rc.xml système —
	# c'est même ainsi que claude-os-theme colore les barres de titre. Seuls
	# les fichiers homonymes de /etc/xdg/labwc sont une anomalie.
	MASQ=""
	for f in rc.xml autostart environment menu.xml; do
		[ -e "${XDG_CONFIG_HOME:-$HOME/.config}/labwc/$f" ] && MASQ="$MASQ $f"
	done
	echo "  ~/.config/labwc : $([ -n "$MASQ" ] && echo "MASQUE /etc/xdg :$MASQ <<<<" || echo 'rien de masquant')"
	echo "--- sortie de labwc ---"
} >> "$JOURNAL" 2>&1

# PAS de « exec » : on veut reprendre la main après la sortie de labwc pour
# enregistrer son code de retour. Sans cette ligne, une session qui meurt en
# une seconde ne laisse rien derrière elle — c'est très exactement ce qui
# rendait cette panne indéchiffrable.
if [ -S "$XDG_RUNTIME_DIR/bus" ] || [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
	labwc "$@" >> "$JOURNAL" 2>&1
elif command -v dbus-run-session >/dev/null 2>&1; then
	# Pas de bus : on en ouvre un pour la durée de la session.
	dbus-run-session -- labwc "$@" >> "$JOURNAL" 2>&1
else
	# Ni bus ni moyen d'en créer un. On démarre quand même : le compositeur
	# fonctionnera, et la trace dira pourquoi le bureau est vide.
	echo "claude-os-session : aucun bus de session, et dbus-run-session est absent." >> "$JOURNAL"
	labwc "$@" >> "$JOURNAL" 2>&1
fi
CODE=$?

echo "=== labwc s'est arrêté — code de retour $CODE ===" >> "$JOURNAL"
exit "$CODE"
