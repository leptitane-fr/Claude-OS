#!/bin/sh
#-------------------------------------------------------------------------------
# Claude OS — Session graphique
#
# Lancé par ~/.xsession. Démarre les composants dans l'ordre qui évite les
# clignotements : fond d'écran, puis compositeur, puis panneaux, puis applets.
# Openbox est exécuté en dernier avec « exec » : c'est lui qui tient la session,
# sa fin termine la session.
#-------------------------------------------------------------------------------
set -u

CONF=/usr/share/claude-os

# Un utilisateur peut surcharger n'importe quel fichier de configuration en
# déposant son propre exemplaire dans ~/.config/claude-os/.
USERCONF="${XDG_CONFIG_HOME:-$HOME/.config}/claude-os"
pick() { [ -f "$USERCONF/$1" ] && echo "$USERCONF/$1" || echo "$CONF/$1"; }

# Fond d'écran avant tout le reste : évite le damier noir au démarrage
if command -v xwallpaper >/dev/null 2>&1; then
	xwallpaper --zoom "$(pick wallpaper/default.png)" 2>/dev/null || true
fi

# Réglages X : pas d'économiseur, pas de mise en veille de l'écran par X
# (c'est logind qui gère la veille), curseur standard
xset s off -dpms 2>/dev/null || true
xsetroot -cursor_name left_ptr 2>/dev/null || true

# Compositeur — coins arrondis, translucidité, ombres
picom --config "$(pick picom/picom.conf)" -b 2>/dev/null || true

# Notifications
dunst &

# Panneaux : dock centré, barre d'état à droite
tint2 -c "$(pick tint2/dock.tint2rc)" &
tint2 -c "$(pick tint2/status.tint2rc)" &

# Applets de la zone de notification. Temporisés : la zone doit exister avant
# qu'ils tentent de s'y insérer, sans quoi leurs icônes n'apparaissent pas.
( sleep 2
  command -v nm-applet       >/dev/null 2>&1 && nm-applet --indicator &
  command -v blueman-applet  >/dev/null 2>&1 && blueman-applet &
) &

# Portail XDG : requis par Electron (Claude Desktop) pour les sélecteurs de
# fichiers et l'ouverture de liens
command -v /usr/libexec/xdg-desktop-portal >/dev/null 2>&1 && /usr/libexec/xdg-desktop-portal &

exec openbox --config-file "$(pick openbox/rc.xml)"
