#!/bin/sh
#-------------------------------------------------------------------------------
# Claude OS — Configuration initiale du dock
#
# POURQUOI CE SCRIPT
# Plank 0.11 et suivants lisent leur configuration dans GSettings (dconf).
# Le fichier ~/.config/plank/dock1/settings est OBSOLÈTE et totalement ignoré :
# le déposer ne fait rien du tout. C'est ce qui faisait tourner le dock sur ses
# valeurs par défaut — mauvaise position, mauvaise taille, thème non appliqué,
# et seules quelques icônes au lieu de celles déclarées.
#
# APPLIQUÉ UNE SEULE FOIS
# Un marqueur empêche de réécrire la configuration à chaque ouverture de
# session : le dock est réorganisable au glisser-déposer, et plank enregistre
# ce nouvel ordre au même endroit. Le réappliquer effacerait le choix de
# l'utilisateur à chaque connexion.
#
#   claude-os-plank-setup          # applique si jamais fait
#   claude-os-plank-setup --force  # réapplique, écrase l'ordre des icônes
#-------------------------------------------------------------------------------
set -u

SCHEMA="net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/"
MARKER="${XDG_CONFIG_HOME:-$HOME/.config}/claude-os/.plank-configured"

FORCE=0
[ "${1:-}" = "--force" ] && FORCE=1

command -v gsettings >/dev/null 2>&1 || exit 0
gsettings list-schemas 2>/dev/null | grep -q '^net\.launchpad\.plank\.dock\.settings$' || {
	echo "claude-os-plank-setup : schéma GSettings de plank absent, rien à faire." >&2
	exit 0
}

if [ -f "$MARKER" ] && [ "$FORCE" -eq 0 ]; then
	exit 0
fi

set_key() {
	# Une clé inconnue d'une version donnée ne doit pas interrompre le reste.
	gsettings set "$SCHEMA" "$1" "$2" 2>/dev/null \
		|| echo "claude-os-plank-setup : clé « $1 » refusée, ignorée." >&2
}

#--- Apparence
set_key theme          "ClaudeOS"
set_key icon-size      40
set_key zoom-enabled   true
set_key zoom-percent   120

#--- Placement : en bas, centré, sans masquage.
# « hide-mode none » est délibéré : le dock ne réserve pas d'espace, si bien que
# les fenêtres maximisées passent dessous, conformément à l'intention.
set_key position       bottom
set_key alignment      center
set_key items-alignment center
set_key offset         0
set_key hide-mode      none
set_key unhide-delay   0
set_key hide-delay     0

#--- Contenu
set_key dock-items "['claude-os-launcher.dockitem', 'claude-os-chromium.dockitem', 'claude-os-claude.dockitem', 'claude-os-notes.dockitem']"
set_key pinned-only    false
set_key auto-pinning   true
set_key show-dock-item false
set_key lock-items     false
set_key current-workspace-only false

mkdir -p "$(dirname "$MARKER")"
: > "$MARKER"
echo "claude-os-plank-setup : dock configuré."
