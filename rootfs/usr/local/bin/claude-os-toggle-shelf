#!/bin/sh
#-------------------------------------------------------------------------------
# Claude OS — masquer / afficher l'étagère (dock + barre d'état)
#
# Lié à la touche Loupe du clavier Chromebook. Cette touche émet Super ; xcape
# convertit un appui bref sur Super SEUL en F13, qu'Openbox intercepte. Super
# combiné à une autre touche garde son rôle habituel.
#
# Les fenêtres maximisées passant sous les panneaux, cette bascule sert à
# dégager le bas de l'écran.
#-------------------------------------------------------------------------------
set -u

STATE="${XDG_RUNTIME_DIR:-/tmp}/claude-os-shelf-hidden"

# tint2 nomme sa fenêtre via « panel_window_name » ; plank s'identifie par sa
# classe. On agit sur les deux, en ignorant l'absence de l'un ou de l'autre.
act() { # act <windowmap|windowunmap>
	xdotool search --name '^claude-os-status$' "$1" 2>/dev/null || true
	xdotool search --class '^[Pp]lank$'        "$1" 2>/dev/null || true
}

if [ -f "$STATE" ]; then
	act windowmap
	rm -f "$STATE"
else
	act windowunmap
	: > "$STATE"
fi
