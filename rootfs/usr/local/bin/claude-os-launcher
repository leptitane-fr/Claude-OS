#!/bin/sh
# Claude OS — lanceur d'applications
#
# Bascule : un second appel referme le lanceur au lieu d'en ouvrir un autre.
# C'est ce qui permet d'appuyer deux fois sur l'icône du dock sans empiler
# les fenêtres.
if pgrep -x rofi >/dev/null 2>&1; then
	pkill -x rofi
	exit 0
fi
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/claude-os/rofi/launcher.rasi"
[ -f "$CONF" ] || CONF=/usr/share/claude-os/rofi/launcher.rasi
exec rofi -show drun -theme "$CONF" -show-icons -drun-display-format '{name}'
