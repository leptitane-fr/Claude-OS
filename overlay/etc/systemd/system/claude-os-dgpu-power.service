[Unit]
Description=Coupe l'alimentation du GPU NVIDIA discret
Documentation=file:///usr/local/sbin/claude-os-dgpu-power

# PAS de systemd-udev-settle : ce service est deprecie par systemd, et
# l'attendre coutait 74 secondes de demarrage mesurees sur le Vivobook.
#
# Il etait inutile : les peripheriques PCI sont enumeres par le noyau avant
# meme que l'espace utilisateur ne demarre, donc /sys/bus/pci/devices est
# deja peuple quand systemd lance le premier service.
After=sysinit.target
Before=display-manager.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/claude-os-dgpu-power
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
