[Unit]
Description=Adapte la partition racine a la taille reelle du support
Documentation=file:///usr/local/sbin/claude-os-firstboot
# La racine doit etre montee en ecriture, et l'operation doit preceder
# l'ouverture de session.
After=local-fs.target
Before=display-manager.service
ConditionPathExists=/usr/local/sbin/claude-os-firstboot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/claude-os-firstboot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
